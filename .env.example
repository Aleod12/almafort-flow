# ALMAFORT B2B — боевые переменные окружения
# Значения НЕ хранятся в репозитории: вносятся через защищённую форму секретов Lovable.
# Этот файл — только справочник имён и форматов.

# --- S3 (Yandex Object Storage): хранение PDF-счетов ---
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=almafort-invoices
S3_ACCESS_KEY_ID=YCAJE...
S3_SECRET_ACCESS_KEY=YCP...

# --- CRM: достаточно одного из двух блоков ---
# Bitrix24 (входящий вебхук)
BITRIX24_WEBHOOK_URL=https://company.bitrix24.ru/rest/1/xxxxxxxxxxxx/
# amoCRM (долгосрочный токен интеграции)
AMOCRM_BASE_URL=https://company.amocrm.ru
AMOCRM_ACCESS_TOKEN=eyJ0eXAiOiJKV1Qi...

# --- Логистика ---
# СДЭК API v2 (боевой аккаунт)
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
# Деловые Линии API v3
DL_API_KEY=

# --- DaData: подсказки городов + ФИАС ---
DADATA_API_KEY=

# --- ИИ-эксперт (Computer Vision) ---
# Выдаётся Lovable автоматически, вручную вносить не нужно
LOVABLE_API_KEY=

# --- Модуль 7: прямая загрузка, антиспам, CRM ---
# Pre-signed URL используют те же ключи S3, что и выгрузка счетов (S3_* выше).
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Фолбек, если CRM недоступна
ADMIN_ALERT_EMAIL=
RESEND_API_KEY=
ALERT_FROM_EMAIL=
# Первичная воронка/стадия для лидов из квиза
CRM_QUIZ_CATEGORY_ID=
CRM_QUIZ_STAGE_ID=
CRM_QUIZ_PIPELINE_ID=

# --- Личный кабинет и трекинг ---
# Общий токен для вебхуков ТК: POST /api/public/webhooks/carrier, заголовок X-Almafort-Token
CARRIER_WEBHOOK_TOKEN=
