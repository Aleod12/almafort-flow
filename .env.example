# ALMAFORT — пример .env для VPS. Скопируйте в .env и заполните.
# cp .env.example .env && nano .env    (chmod 600 .env)

# --- Сервер ---
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
WEB_CONCURRENCY=2

# --- Backend (Lovable Cloud) — обязательные ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Серверные дубли тех же значений (используются server-функциями)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Приватный ключ бэкенда (только сервер, никогда не в браузер)
SUPABASE_SERVICE_ROLE_KEY=

# --- ИИ (адаптер src/lib/ai-provider.server.ts) ---
# Режим: lovable | openai | gemini. Можно задать отдельно для камеры и конфигуратора.
AI_PROVIDER=lovable
#AI_PROVIDER_VISION=gemini
#AI_PROVIDER_CONFIGURATOR=openai

# Шлюз Lovable (тесты / период миграции)
LOVABLE_API_KEY=
#LOVABLE_BASE_URL=https://ai.gateway.lovable.dev/v1

# OpenAI напрямую или через российский API-шлюз (совместимый с OpenAI)
OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o
#OPENAI_VISION_MODEL=gpt-4o

# Google Gemini через OpenAI-совместимый эндпоинт или свой шлюз
GEMINI_API_KEY=
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#GEMINI_MODEL=gemini-2.0-flash
#GEMINI_VISION_MODEL=gemini-2.0-flash


# --- Админ-хранилище ключей (AES-256-GCM) ---
ADMIN_VAULT_KEY=

# --- Почта / оповещения ---
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ADMIN_ALERT_EMAIL=

# --- CRM ---
AMOCRM_BASE_URL=
AMOCRM_ACCESS_TOKEN=
BITRIX24_WEBHOOK_URL=
CRM_QUIZ_PIPELINE_ID=
CRM_QUIZ_STAGE_ID=
CRM_QUIZ_CATEGORY_ID=

# --- Интеграции / вебхуки ---
CARRIER_WEBHOOK_TOKEN=
CATALOG_SYNC_TOKEN=
RECAPTCHA_SECRET_KEY=

# --- S3 (shadow-логи распознавания, CAD-файлы) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_CAD_BUCKET=
